#!/usr/bin/env bash
#
# pre-commit: block master commits, lint staged files, refuse GitButler hooks.
#
# Tracked here; installed into .git/hooks by `just hooks`. Do not set
# core.hooksPath to this directory. GitButler would overwrite these files.

set -u

if git diff --cached --name-only .githooks/ | grep -q . \
  && git diff --cached .githooks/ | grep -q 'GITBUTLER_MANAGED_HOOK_V1'; then
  echo "x GitButler-managed hooks must not be committed."
  echo "  They belong in .git/hooks. Restore .githooks from git and re-run just hooks."
  exit 1
fi

PROTECTED="master"
branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
if [ "$branch" = "$PROTECTED" ]; then
  echo "x Direct commits to '$PROTECTED' are blocked."
  echo "  Work on a feature branch and open a PR into '$PROTECTED'."
  exit 1
fi

# Collect staged (added/copied/modified) files, NUL-safe.
staged_sh=()
staged_lua=()
while IFS= read -r -d '' f; do
  case "$f" in
    *.sh|*.bash) staged_sh+=("$f") ;;
    *.lua)       staged_lua+=("$f") ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACM -z)

status=0

if [ "${#staged_sh[@]}" -gt 0 ]; then
  if command -v shellcheck >/dev/null 2>&1; then
    # --severity=error: gate on genuine bugs only, so pre-existing info/warning
    # findings in the repo don't block commits. Tighten to =warning/=info after
    # a repo-wide cleanup.
    if ! shellcheck --severity=error "${staged_sh[@]}"; then
      echo "x shellcheck found errors in staged shell scripts."
      status=1
    fi
  else
    echo "warn: shellcheck not installed, skipping shell lint (brew install shellcheck)"
  fi
fi

if [ "${#staged_lua[@]}" -gt 0 ]; then
  if command -v stylua >/dev/null 2>&1; then
    if ! stylua --check "${staged_lua[@]}"; then
      echo "x stylua --check failed. Run: stylua ${staged_lua[*]}"
      status=1
    fi
  else
    echo "warn: stylua not installed, skipping Lua lint (brew install stylua)"
  fi
fi

exit "$status"
