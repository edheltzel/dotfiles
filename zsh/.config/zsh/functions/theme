# Switch color theme across all apps
theme() {
  local themes_dir="$HOME/.config/theme-switcher"
  local script="$themes_dir/theme-switcher.sh"

  if [[ ! -x "$script" ]]; then
    echo "Error: Theme switcher script not found at $script" >&2
    return 1
  fi

  if (( $# == 0 )); then
    "$script"
  else
    "$script" "$1"
  fi
}
