# grit (https://grit-scm.com) — Git-compatible CLI.
# Binary lives in ~/.local/bin (already on PATH via paths.fish).
# Completions are the tracked file completions/grit.fish, generated by
# `grit completions fish`. Regenerate that file after `grit update`.
if status is-interactive
    # Pager for `grit log`. core.pager is already delta; this wins for grit only
    # and is executed by sh -c, so a pipeline is fine and a fish function is not.
    set -gx GRIT_PAGER "delta --dark"
end
